{
  "name": "polbeo/kirby-komments-remote-moderation",
  "description": "Secure remote moderation bridge and Kirby Panel console for Komments.",
  "type": "kirby-plugin",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "getkirby/cms": "^5.0",
    "mauricerenck/komments": "^3.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4.5",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "Polbeo\\KirbyKommentsRemoteModeration\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Polbeo\\KirbyKommentsRemoteModeration\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "sort-packages": true
  }
}
